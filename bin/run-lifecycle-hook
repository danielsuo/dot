#!/usr/bin/env bash
set -euo pipefail

# run-lifecycle-hook: Universal event dispatcher for agent & developer lifecycle hooks.
# Usage:
#   run-lifecycle-hook on_session_start
#   run-lifecycle-hook on_pre_review
#   run-lifecycle-hook on_user_correction [feedback_string]
#   run-lifecycle-hook on_change_landed

EVENT="${1:-}"
if [[ -z "$EVENT" ]]; then
  echo "Usage: run-lifecycle-hook <on_session_start|on_pre_review|on_user_correction|on_change_landed> [args...]" >&2
  exit 1
fi
shift || true

# 1. Resolve Skills Root dynamically
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v find-skills-root >/dev/null 2>&1; then
  SKILLS_ROOT="$(find-skills-root)"
elif [[ -x "${SCRIPT_DIR}/find-skills-root" ]]; then
  SKILLS_ROOT="$("${SCRIPT_DIR}/find-skills-root")"
else
  SKILLS_ROOT="${PWD}/.skills"
fi

# Locate project verification skill
VERIFY_SKILL=""
if [[ -d "$SKILLS_ROOT" ]]; then
  for dir in "${SKILLS_ROOT}"/verify-*; do
    if [[ -d "$dir" ]]; then
      VERIFY_SKILL="$dir"
      break
    fi
  done
fi

case "$EVENT" in
  on_session_start|on_task_start)
    echo "==> [lifecycle] on_session_start: Verifying environment health..."
    if [[ -n "$VERIFY_SKILL" && -x "${VERIFY_SKILL}/scripts/doctor.sh" ]]; then
      "${VERIFY_SKILL}/scripts/doctor.sh"
    else
      echo "--> No verify-*/scripts/doctor.sh found at ${SKILLS_ROOT}; skipping."
    fi
    ;;

  on_pre_review)
    echo "==> [lifecycle] on_pre_review: Executing Tier 2 verification gate..."
    if [[ -n "$VERIFY_SKILL" && -f "${VERIFY_SKILL}/scripts/verify.py" ]]; then
      python3 "${VERIFY_SKILL}/scripts/verify.py" --tier=2
    elif [[ -n "$VERIFY_SKILL" && -x "${VERIFY_SKILL}/scripts/doctor.sh" ]]; then
      "${VERIFY_SKILL}/scripts/doctor.sh"
    else
      echo "--> No verify-*/scripts/verify.py found; checking native tests..."
      if [[ -f "Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
        cargo test
      elif [[ -f "package.json" ]] && command -v npm >/dev/null 2>&1; then
        npm test
      elif [[ -f "pyproject.toml" || -f "setup.py" ]] && command -v pytest >/dev/null 2>&1; then
        pytest
      fi
    fi
    ;;

  on_user_correction)
    FEEDBACK="${*:-}"
    echo "==> [lifecycle] on_user_correction: Triggering escaped defect ingestion..."
    if [[ -n "$FEEDBACK" ]]; then
      echo "--> User Feedback: $FEEDBACK"
    fi
    # If maintain-verification-skill has an automated script or runner:
    MAINTAIN_SCRIPT="${SKILLS_ROOT}/maintain-verification-skill/scripts/maintain.py"
    if [[ -f "$MAINTAIN_SCRIPT" ]]; then
      python3 "$MAINTAIN_SCRIPT" --mode=correction --feedback="$FEEDBACK"
    else
      echo "--> Verification maintenance skill ready for ingestion pass in ${SKILLS_ROOT}."
    fi
    ;;

  on_change_landed|on_task_done)
    echo "==> [lifecycle] on_change_landed: Triggering post-landing upkeep pass..."
    MAINTAIN_SCRIPT="${SKILLS_ROOT}/maintain-verification-skill/scripts/maintain.py"
    if [[ -f "$MAINTAIN_SCRIPT" ]]; then
      python3 "$MAINTAIN_SCRIPT" --mode=upkeep
    elif [[ -n "$VERIFY_SKILL" && -f "${VERIFY_SKILL}/scripts/verify.py" ]]; then
      echo "--> Running full Tier 3 outer loop verification..."
      python3 "${VERIFY_SKILL}/scripts/verify.py" --tier=3 || true
    fi
    ;;

  *)
    echo "Unknown lifecycle event: $EVENT" >&2
    exit 1
    ;;
esac
