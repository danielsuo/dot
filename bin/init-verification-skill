#!/usr/bin/env bash
set -euo pipefail

# init-verification-skill: Bootstrap verification scripts and features directory for a project.
# Usage: init-verification-skill

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATES="${SCRIPT_DIR}/../skills/ensure-verification-skill/templates"

if [[ ! -d "$TEMPLATES" ]]; then
  echo "Error: Templates directory not found at $TEMPLATES" >&2
  exit 1
fi

mkdir -p scripts features

cp "${TEMPLATES}/doctor.template.sh" scripts/doctor.sh
cp "${TEMPLATES}/verify.template.py" scripts/verify.py

chmod +x scripts/doctor.sh scripts/verify.py

echo "✓ Initialized verification suite:"
echo "  - scripts/doctor.sh"
echo "  - scripts/verify.py"
echo "  - features/"
