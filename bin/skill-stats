#!/usr/bin/env python3
"""skill-stats: Multi-harness Skill Usage Telemetry & Analytics CLI.

Provides robust, verifiable skill usage statistics across:
1. Universal Skill Usage Log (~/.config/skills/usage.jsonl)
2. Beekeeper Swarm Tool Executions (~/.config/swarm/logs/<session>/*.json)

Distinguishes between REAL TOOL EXECUTIONS vs CONVERSATIONAL MENTIONS.
Tracks Takt time (recency drift), execution latencies, and caller agents.

STATUS LEGEND:
  [✓] Verified Active : Real tool/harness execution recorded & proven live in workspace.
  [·] Discussion Only : Mentioned in context/prompts, but 0 real tool executions.
"""

import argparse
import glob
import hashlib
import json
import os
import re
import sys
from collections import defaultdict
from datetime import datetime, timezone

# Canonical alias mapping (merging variants into single canonical name)
CANONICAL_ALIASES = {
    "verify-jax-dashboard": "verify-jax-observatory",
    "verify-jax-observ": "verify-jax-observatory",
    "verify-jax-observato": "verify-jax-observatory",
    "verify-jax-ob": "verify-jax-observatory",
    "verify-jax": "verify-jax-observatory",
    "verify-jax-dashbo": "verify-jax-observatory",
    "verify-j": "verify-jax-observatory",
}

SKILL_NAME_RE = re.compile(
    r'\b(verify-[a-zA-Z0-9_-]+|ensure-verification-skill|find-skills-root)\b'
)

def canonicalize(name):
    return CANONICAL_ALIASES.get(name, name)

class Palette:
    def __init__(self, enabled=True):
        self.enabled = enabled
        ESC = chr(27)
        if enabled:
            self.RESET = f"{ESC}[0m"
            self.BOLD = f"{ESC}[1m"
            self.DIM = f"{ESC}[2m"
            self.EMERALD = f"{ESC}[38;5;48m"
            self.CYAN = f"{ESC}[38;5;51m"
            self.AMBER = f"{ESC}[38;5;214m"
            self.PURPLE = f"{ESC}[38;5;141m"
            self.SLATE = f"{ESC}[38;5;245m"
            self.BORDER = f"{ESC}[38;5;239m"
            self.WHITE = f"{ESC}[97m"
            self.RED = f"{ESC}[38;5;196m"
            self.BADGE_GREEN = f"{ESC}[48;5;22m{ESC}[38;5;48m{ESC}[1m"
            self.BADGE_GRAY = f"{ESC}[48;5;236m{ESC}[38;5;248m"
        else:
            self.RESET = ""
            self.BOLD = ""
            self.DIM = ""
            self.EMERALD = ""
            self.CYAN = ""
            self.AMBER = ""
            self.PURPLE = ""
            self.SLATE = ""
            self.BORDER = ""
            self.WHITE = ""
            self.RED = ""
            self.BADGE_GREEN = ""
            self.BADGE_GRAY = ""

ANSI_RE = re.compile(rf"{chr(27)}\[[0-9;]*m")

def visible_len(s):
    return len(ANSI_RE.sub("", s))

def pad_str(s, width, align="left"):
    v = visible_len(s)
    diff = max(0, width - v)
    if align == "right":
        return " " * diff + s
    elif align == "center":
        left = diff // 2
        right = diff - left
        return " " * left + s + " " * right
    return s + " " * diff

def box_line(content, inner_width, pal):
    return f"{pal.BORDER}│{pal.RESET} {pad_str(content, inner_width)} {pal.BORDER}│{pal.RESET}"

def scan_skills_usage_file(log_path):
    """Parses structured entries from ~/.config/skills/usage.jsonl."""
    records = []
    if not os.path.exists(log_path):
        return records
    with open(log_path, "r", errors="ignore") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
                record["skill"] = canonicalize(record.get("skill", ""))
                records.append(record)
            except Exception:
                continue
    return records

def load_execution_ledger():
    """Loads persistent ledger of observed executions to survive context compaction."""
    ledger_path = os.path.expanduser("~/.config/skills/execution_ledger.json")
    if os.path.exists(ledger_path):
        try:
            with open(ledger_path, "r") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_execution_ledger(ledger):
    """Saves persistent execution ledger."""
    ledger_dir = os.path.expanduser("~/.config/skills")
    os.makedirs(ledger_dir, exist_ok=True)
    ledger_path = os.path.join(ledger_dir, "execution_ledger.json")
    try:
        with open(ledger_path, "w") as f:
            json.dump(ledger, f, indent=2)
    except Exception:
        pass

def scan_swarm_sessions(swarm_logs_dir, latest_only=True):
    """Scans Beekeeper swarm sessions separating real tool calls from text mentions.
    
    Uses an append-only execution ledger (~/.config/skills/execution_ledger.json)
    so that earlier tool executions are never lost when an agent's context is compacted.
    """
    stats = defaultdict(lambda: {
        "real_execs": 0,
        "mentions": 0,
        "agents": set(),
        "last_exec_ts": None,
        "latencies_ms": [],
        "failures": 0,
    })

    ledger = load_execution_ledger()
    ledger_modified = False

    # Seed stats with previously recorded ledger executions
    for call_key, entry in ledger.items():
        s = canonicalize(entry.get("skill", ""))
        if not s:
            continue
        stats[s]["real_execs"] += 1
        agent = entry.get("agent", "unknown")
        stats[s]["agents"].add(agent)
        ts_str = entry.get("ts")
        if ts_str:
            try:
                dt = datetime.fromisoformat(ts_str)
                if not stats[s]["last_exec_ts"] or dt > stats[s]["last_exec_ts"]:
                    stats[s]["last_exec_ts"] = dt
            except Exception:
                pass

    if not os.path.exists(swarm_logs_dir):
        return stats

    session_dirs = sorted(
        [d for d in glob.glob(os.path.join(swarm_logs_dir, "2026*")) if os.path.isdir(d)],
        reverse=True
    )
    if latest_only and session_dirs:
        session_dirs = session_dirs[:1]

    for sdir in session_dirs:
        sdir_name = os.path.basename(sdir)
        for fpath in glob.glob(os.path.join(sdir, "*.json")):
            fname = os.path.basename(fpath)
            if fname.endswith((".hseq", ".lineage")) or "tool_journal" in fname:
                continue
            agent_name = fname.replace(".json", "")
            try:
                with open(fpath, "r", errors="ignore") as fh:
                    data = json.load(fh)
                history = data.get("history", [])
                mtime = os.path.getmtime(fpath)
                mtime_dt = datetime.fromtimestamp(mtime, tz=timezone.utc)

                for item_idx, item in enumerate(history):
                    # 1. Conversational mentions
                    text = str(item)
                    for match in set(SKILL_NAME_RE.findall(text)):
                        cname = canonicalize(match)
                        stats[cname]["mentions"] += 1

                    # 2. Real functionCall executions
                    parts = item.get("parts", []) if isinstance(item, dict) else []
                    for part_idx, part in enumerate(parts):
                        if isinstance(part, dict) and "functionCall" in part:
                            fc = part["functionCall"]
                            if fc.get("name") == "run_shell_command":
                                cmd = fc.get("args", {}).get("command", "")
                                matched_skill = None
                                if "find-skills-root" in cmd:
                                    matched_skill = "find-skills-root"
                                elif "verify-jax-observatory" in cmd or "verify-jax-dashboard" in cmd or "scripts/verify.py" in cmd:
                                    matched_skill = "verify-jax-observatory"
                                elif "scripts/doctor.sh" in cmd:
                                    matched_skill = "verify-jax-observatory"

                                if matched_skill:
                                    cname = canonicalize(matched_skill)
                                    cmd_hash = hashlib.sha256(cmd.encode("utf-8")).hexdigest()[:16]
                                    call_key = f"{sdir_name}:{agent_name}:{cname}:{item_idx}:{part_idx}:{cmd_hash}"
                                    if call_key not in ledger:
                                        ledger[call_key] = {
                                            "skill": cname,
                                            "agent": agent_name,
                                            "ts": mtime_dt.isoformat(),
                                            "command": cmd[:120]
                                        }
                                        ledger_modified = True
                                        stats[cname]["real_execs"] += 1
                                        stats[cname]["agents"].add(agent_name)
                                        if not stats[cname]["last_exec_ts"] or mtime_dt > stats[cname]["last_exec_ts"]:
                                            stats[cname]["last_exec_ts"] = mtime_dt
            except Exception:
                continue

    if ledger_modified:
        save_execution_ledger(ledger)

    return stats

def log_skill_invocation(skill_name, action="run", agent="user", harness="cli", status="ok", duration_ms=0, tier=2):
    """Appends an atomic usage record to ~/.config/skills/usage.jsonl."""
    config_dir = os.path.expanduser("~/.config/skills")
    os.makedirs(config_dir, exist_ok=True)
    log_file = os.path.join(config_dir, "usage.jsonl")

    record = {
        "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "skill": canonicalize(skill_name),
        "action": action,
        "agent": agent,
        "harness": harness,
        "status": status,
        "duration_ms": duration_ms,
        "tier": tier,
    }
    with open(log_file, "a") as fh:
        fh.write(json.dumps(record) + "\n")

def print_dashboard(stats, usage_records, color=True):
    pal = Palette(enabled=color)
    now = datetime.now(timezone.utc)
    inner_w = 95

    # Ingest structured usage records
    for r in usage_records:
        s = canonicalize(r.get("skill", ""))
        if not s:
            continue
        stats[s]["real_execs"] += 1
        agent = r.get("agent", "unknown")
        stats[s]["agents"].add(agent)
        ts_str = r.get("timestamp")
        if ts_str:
            try:
                dt = datetime.strptime(ts_str, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
                if not stats[s]["last_exec_ts"] or dt > stats[s]["last_exec_ts"]:
                    stats[s]["last_exec_ts"] = dt
            except Exception:
                pass
        dur = r.get("duration_ms", 0)
        if dur > 0:
            stats[s]["latencies_ms"].append(dur)
        if r.get("status") not in ("ok", "pass", "success"):
            stats[s]["failures"] += 1

    sorted_skills = sorted(stats.items(), key=lambda x: (-x[1]["real_execs"], -x[1]["mentions"]))

    top_border = f"{pal.BORDER}╭{'─' * (inner_w + 2)}╮{pal.RESET}"
    mid_border = f"{pal.BORDER}├{'─' * (inner_w + 2)}┤{pal.RESET}"
    bot_border = f"{pal.BORDER}╰{'─' * (inner_w + 2)}╯{pal.RESET}"

    print(top_border)
    title_left = f"{pal.EMERALD}⚡{pal.RESET} {pal.BOLD}{pal.WHITE}Skill Usage Telemetry & Analytics{pal.RESET}"
    title_right = f"{pal.SLATE}{now.strftime('%Y-%m-%d %H:%M UTC')}{pal.RESET}"
    header_content = pad_str(title_left, inner_w - visible_len(title_right)) + title_right
    print(box_line(header_content, inner_w, pal))
    print(mid_border)

    col_hdr = (
        f"  {pal.BOLD}{pal.SLATE}{'STATUS':<7}{pal.RESET} "
        f"{pal.BOLD}{pal.WHITE}{'SKILL':<27}{pal.RESET} "
        f"{pal.BOLD}{pal.CYAN}{'REAL RUNS':<11}{pal.RESET} "
        f"{pal.BOLD}{pal.PURPLE}{'DISCUSSIONS':<13}{pal.RESET} "
        f"{pal.BOLD}{pal.AMBER}{'TAKT RECENCY':<15}{pal.RESET} "
        f"{pal.BOLD}{pal.SLATE}{'CALLERS':<17}{pal.RESET}"
    )
    print(box_line(col_hdr, inner_w, pal))
    print(mid_border)

    if not sorted_skills:
        print(box_line(f"  {pal.SLATE}No skill telemetry recorded yet.{pal.RESET}", inner_w, pal))
    else:
        for skill, data in sorted_skills:
            real_cnt = data["real_execs"]
            mention_cnt = data["mentions"]
            agents_str = ", ".join(sorted(data["agents"])) if data["agents"] else "none"
            if len(agents_str) > 17:
                agents_str = agents_str[:14] + "..."

            if data["last_exec_ts"]:
                delta = now - data["last_exec_ts"]
                hours = delta.total_seconds() / 3600.0
                if hours < 1:
                    mins = int(delta.total_seconds() / 60)
                    takt_raw = f"{mins}m ago"
                    takt_styled = f"{pal.EMERALD}{takt_raw}{pal.RESET}"
                elif hours < 24:
                    takt_raw = f"{hours:.1f}h ago"
                    takt_styled = f"{pal.CYAN}{takt_raw}{pal.RESET}"
                else:
                    days = int(hours / 24)
                    takt_raw = f"{days}d ago [DRIFT]"
                    takt_styled = f"{pal.AMBER}{pal.BOLD}{takt_raw}{pal.RESET}"
            else:
                takt_raw = "Never Run"
                takt_styled = f"{pal.SLATE}{takt_raw}{pal.RESET}"

            if real_cnt > 0:
                badge = f"{pal.EMERALD}{pal.BOLD}[✓]{pal.RESET}"
                skill_styled = f"{pal.BOLD}{pal.WHITE}{skill:<27}{pal.RESET}"
                runs_styled = f"{pal.EMERALD}{pal.BOLD}[ {real_cnt:>2} ]{pal.RESET}     "
            else:
                badge = f"{pal.SLATE}[·]{pal.RESET}"
                skill_styled = f"{pal.SLATE}{skill:<27}{pal.RESET}"
                runs_styled = f"{pal.SLATE}[  0 ]     {pal.RESET}"

            mentions_styled = f"{pal.PURPLE}{mention_cnt:>4} mentions{pal.RESET}"
            callers_styled = f"{pal.CYAN}{agents_str:<17}{pal.RESET}" if real_cnt > 0 else f"{pal.SLATE}{agents_str:<17}{pal.RESET}"

            row = (
                f"  {badge}  "
                f"{skill_styled} "
                f"{runs_styled} "
                f"{mentions_styled} "
                f"{pad_str(takt_styled, 15)} "
                f"{callers_styled}"
            )
            print(box_line(row, inner_w, pal))

    print(mid_border)
    print(box_line(f"  {pal.BOLD}{pal.WHITE}STATUS LEGEND:{pal.RESET}", inner_w, pal))
    print(box_line(f"   {pal.EMERALD}[✓] Verified Active{pal.RESET} : Real tool/harness execution recorded & proven live in workspace.", inner_w, pal))
    print(box_line(f"   {pal.SLATE}[·] Discussion Only{pal.RESET} : Mentioned in context/prompts, but {pal.BOLD}0 real tool executions{pal.RESET}.", inner_w, pal))
    print(box_line("", inner_w, pal))
    print(box_line(f"  {pal.BOLD}{pal.WHITE}METRICS DEFINITION:{pal.RESET}", inner_w, pal))
    print(box_line(f"   • {pal.BOLD}REAL RUNS{pal.RESET}   : Confirmed CLI & subagent executions (bash commands, scripts, doctor, verify).", inner_w, pal))
    print(box_line(f"   • {pal.BOLD}DISCUSSIONS{pal.RESET} : Frequency of appearance across prompts, system tools, and chat threads.", inner_w, pal))
    print(box_line(f"   • {pal.BOLD}TAKT RECENCY{pal.RESET}: Elapsed time since last run. Warns {pal.AMBER}[DRIFT RISK]{pal.RESET} if >24 hours stale.", inner_w, pal))
    print(bot_border)

def render_html_widget(stats, usage_records):
    now = datetime.now(timezone.utc)
    for r in usage_records:
        s = canonicalize(r.get("skill", ""))
        if not s:
            continue
        stats[s]["real_execs"] += 1
        agent = r.get("agent", "unknown")
        stats[s]["agents"].add(agent)
        ts_str = r.get("timestamp")
        if ts_str:
            try:
                dt = datetime.strptime(ts_str, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
                if not stats[s]["last_exec_ts"] or dt > stats[s]["last_exec_ts"]:
                    stats[s]["last_exec_ts"] = dt
            except Exception:
                pass

    sorted_skills = sorted(stats.items(), key=lambda x: (-x[1]["real_execs"], -x[1]["mentions"]))

    rows_html = []
    for skill, data in sorted_skills:
        real_cnt = data["real_execs"]
        mention_cnt = data["mentions"]
        agents_str = ", ".join(sorted(data["agents"])) if data["agents"] else "none"
        if len(agents_str) > 22:
            agents_str = agents_str[:19] + "..."

        if data["last_exec_ts"]:
            delta = now - data["last_exec_ts"]
            hours = delta.total_seconds() / 3600.0
            if hours < 1:
                takt_str = f"{int(delta.total_seconds() / 60)}m ago"
                takt_badge = f'<span style="color: var(--sd-working, #10b981);">{takt_str}</span>'
            elif hours < 24:
                takt_str = f"{hours:.1f}h ago"
                takt_badge = f'<span style="color: var(--sd-accent, #38bdf8);">{takt_str}</span>'
            else:
                takt_str = f"{int(hours / 24)}d ago"
                takt_badge = f'<span style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 2px 6px; border-radius: 4px; font-weight: 600;">{takt_str} [DRIFT]</span>'
        else:
            takt_badge = '<span style="color: var(--sd-muted, #94a3b8);">Never Run</span>'

        if real_cnt > 0:
            status_badge = '<span style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 2px 7px; border-radius: 12px; font-weight: 600; font-size: 11px;">✓ ACTIVE</span>'
            runs_badge = f'<span style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-family: monospace;">{real_cnt}</span>'
            skill_text = f'<strong style="color: var(--sd-fg, #f8fafc);">{skill}</strong>'
        else:
            status_badge = '<span style="background: rgba(100, 116, 139, 0.15); color: #94a3b8; padding: 2px 7px; border-radius: 12px; font-weight: 500; font-size: 11px;">· IDLE</span>'
            runs_badge = '<span style="color: var(--sd-muted, #64748b); font-family: monospace;">0</span>'
            skill_text = f'<span style="color: var(--sd-muted, #94a3b8);">{skill}</span>'

        mentions_text = f'<span style="color: var(--sd-accent, #818cf8);">{mention_cnt}</span>'
        callers_text = f'<code style="font-size: 11px; color: var(--sd-fg, #cbd5e1);">{agents_str}</code>'

        rows_html.append(f"""
    <tr style="border-bottom: 1px solid var(--sd-bd, rgba(255,255,255,0.06));">
      <td style="padding: 7px 10px;">{status_badge}</td>
      <td style="padding: 7px 10px;">{skill_text}</td>
      <td style="padding: 7px 10px; text-align: center;">{runs_badge}</td>
      <td style="padding: 7px 10px; text-align: right;">{mentions_text}</td>
      <td style="padding: 7px 10px;">{takt_badge}</td>
      <td style="padding: 7px 10px;">{callers_text}</td>
    </tr>""")

    tbody = "\n".join(rows_html)

    html = f"""<html-inline>
<div style="font-family: system-ui, -apple-system, sans-serif; font-size: 12.5px; line-height: 1.5; padding: 14px 16px; background: var(--sd-card, #1e293b); border: 1px solid var(--sd-card-bd, #334155); border-radius: 10px; color: var(--sd-fg, #f8fafc); margin: 4px 0;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--sd-bd, #334155); padding-bottom: 8px; margin-bottom: 10px;">
    <span style="font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 6px;">
      <span style="color: var(--sd-working, #10b981);">⚡</span> Skill Usage Telemetry &amp; Analytics
    </span>
    <span style="font-size: 11px; color: var(--sd-muted, #94a3b8);">{now.strftime('%Y-%m-%d %H:%M UTC')}</span>
  </div>

  <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 12px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--sd-bd, #334155); text-align: left; color: var(--sd-muted, #94a3b8); font-size: 11px; text-transform: uppercase;">
        <th style="padding: 6px 10px;">Status</th>
        <th style="padding: 6px 10px;">Skill</th>
        <th style="padding: 6px 10px; text-align: center;">Real Runs</th>
        <th style="padding: 6px 10px; text-align: right;">Discussions</th>
        <th style="padding: 6px 10px;">Takt Recency</th>
        <th style="padding: 6px 10px;">Callers</th>
      </tr>
    </thead>
    <tbody>
{tbody}
    </tbody>
  </table>

  <div style="background: var(--sd-soft, rgba(0,0,0,0.2)); border-radius: 6px; padding: 9px 12px; font-size: 11.5px; line-height: 1.5; color: var(--sd-muted, #94a3b8);">
    <div style="font-weight: 600; color: var(--sd-fg, #f8fafc); margin-bottom: 4px;">Status Legend:</div>
    <div><span style="color: var(--sd-working, #10b981); font-weight: 600;">✓ Active</span> : Real tool/harness execution recorded &amp; proven live in workspace.</div>
    <div><span style="color: var(--sd-muted, #94a3b8); font-weight: 600;">· Idle</span> : Mentioned in context/prompts, but <strong>0 real tool executions</strong>.</div>
    <div style="margin-top: 6px; font-size: 11px; opacity: 0.85;">
      • <strong>Real Runs</strong>: Confirmed shell tool executions. • <strong>Discussions</strong>: Context mentions in prompt history.
    </div>
  </div>
</div>
</html-inline>"""
    return html

def main():
    parser = argparse.ArgumentParser(
        description="Skill Usage Telemetry & Analytics CLI",
        epilog="""
STATUS LEGEND:
  [✓] Verified Active : Real tool/harness execution recorded & proven live in workspace.
  [·] Discussion Only : Mentioned in context/prompts, but 0 real tool executions.
        """
    )
    parser.add_argument("--json", action="store_true", help="Output in JSON format")
    parser.add_argument("--html", action="store_true", help="Output rich HTML dashboard card")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color output")
    parser.add_argument("--color", action="store_true", help="Force ANSI color output")
    parser.add_argument("--all-sessions", action="store_true", help="Scan all historical swarm sessions")
    parser.add_argument("--log-call", type=str, help="Log a skill invocation (e.g. --log-call verify-app)")
    parser.add_argument("--agent", type=str, default="user", help="Caller agent name")
    parser.add_argument("--harness", type=str, default="cli", help="Harness environment (cursor, beekeeper, cli)")
    parser.add_argument("--duration-ms", type=int, default=0, help="Execution duration in milliseconds")
    parser.add_argument("--tier", type=int, default=2, help="Execution tier (1, 2, or 3)")
    args = parser.parse_args()

    if args.log_call:
        log_skill_invocation(
            args.log_call,
            agent=args.agent,
            harness=args.harness,
            duration_ms=args.duration_ms,
            tier=args.tier
        )
        print(f"Logged skill execution: {canonicalize(args.log_call)} (agent={args.agent}, tier={args.tier})")
        return

    usage_log = os.path.expanduser("~/.config/skills/usage.jsonl")
    swarm_logs = os.path.expanduser("~/.config/swarm/logs")

    usage_records = scan_skills_usage_file(usage_log)
    stats = scan_swarm_sessions(swarm_logs, latest_only=not args.all_sessions)

    if args.json:
        out = {}
        for k, v in stats.items():
            out[k] = {
                "real_executions": v["real_execs"],
                "conversational_mentions": v["mentions"],
                "agents": list(v["agents"]),
                "last_execution": v["last_exec_ts"].isoformat() if v["last_exec_ts"] else None,
            }
        print(json.dumps(out, indent=2))
    elif args.html:
        print(render_html_widget(stats, usage_records))
    else:
        use_color = True
        if args.no_color or os.environ.get("NO_COLOR"):
            use_color = False
        elif not sys.stdout.isatty() and not args.color:
            use_color = False
        print_dashboard(stats, usage_records, color=use_color)

if __name__ == "__main__":
    main()

