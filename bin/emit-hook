#!/usr/bin/env python3
"""emit-hook: Non-blocking event emitter for the dsuo hooks queue daemon (hooksd).

Usage:
    emit-hook <event_name> [--repo=<path>] [--data=<json>] [--sync]

Examples:
    emit-hook on_pre_review
    emit-hook on_user_correction --data '{"feedback": "chart dropped zero values"}'
    emit-hook hooks_changed
"""

import argparse
import json
import os
import subprocess
import sys
import time
import uuid

QUEUE_DIR = os.path.expanduser("~/.config/hooks/queue")


def main():
    parser = argparse.ArgumentParser(description="Emit an event to hooksd")
    parser.add_argument("event", help="Event name (e.g. on_pre_review, hooks_changed)")
    parser.add_argument("--repo", default=os.getcwd(), help="Target repository root")
    parser.add_argument("--data", default="{}", help="Optional JSON metadata payload")
    parser.add_argument("--sync", action="store_true", help="Run synchronously instead of queuing")

    args = parser.parse_args()

    try:
        payload_data = json.loads(args.data)
    except Exception as e:
        payload_data = {"raw": args.data}

    event_id = f"evt_{int(time.time()*1000)}_{uuid.uuid4().hex[:8]}"
    event_payload = {
        "id": event_id,
        "event": args.event,
        "repo": os.path.abspath(args.repo),
        "data": payload_data,
        "timestamp": time.time(),
    }

    if args.sync:
        # Synchronous bypass: execute directly using hooksd runner logic
        from hooksd import dispatch_event
        sys.exit(dispatch_event(event_payload))

    # Asynchronous non-blocking queue: atomic write to queue spool
    os.makedirs(QUEUE_DIR, exist_ok=True)
    temp_file = os.path.join(QUEUE_DIR, f".tmp_{event_id}.json")
    final_file = os.path.join(QUEUE_DIR, f"{int(time.time()*1000)}_{event_id}.json")

    with open(temp_file, "w", encoding="utf-8") as f:
        json.dump(event_payload, f)
    os.rename(temp_file, final_file)

    print(f"[emit-hook] Queued event '{args.event}' ({event_id})")


if __name__ == "__main__":
    main()
