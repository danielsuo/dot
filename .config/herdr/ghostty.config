# Ensure this points to your herdr binary
command = /Users/dsuo/.local/bin/herdr

# Deny native macOS Menu Bar key equivalents so custom keybinds take effect
macos-shortcuts = deny
macos-option-as-alt = true

# Terminal Clear & Editing
keybind = super+k=text:\x0c
keybind = alt+arrow_left=text:\x1bb
keybind = alt+arrow_right=text:\x1bf
keybind = alt+backspace=text:\x17

# Tab Creation & Navigation (Cmd+N, Cmd+T, Cmd+W)
keybind = super+t=text:\x02c
keybind = super+n=text:\x02c
keybind = super+w=text:\x02X
keybind = super+shift+]=text:\x02n
keybind = super+shift+[=text:\x02p

# Direct Tab Jumps (Cmd+1..9)
keybind = super+1=text:\x021
keybind = super+digit_1=text:\x021
keybind = super+2=text:\x022
keybind = super+digit_2=text:\x022
keybind = super+3=text:\x023
keybind = super+digit_3=text:\x023
keybind = super+4=text:\x024
keybind = super+digit_4=text:\x024
keybind = super+5=text:\x025
keybind = super+digit_5=text:\x025
keybind = super+6=text:\x026
keybind = super+digit_6=text:\x026
keybind = super+7=text:\x027
keybind = super+digit_7=text:\x027
keybind = super+8=text:\x028
keybind = super+digit_8=text:\x028
keybind = super+9=text:\x029
keybind = super+digit_9=text:\x029

# Workspace Tree & Fuzzy Switcher
keybind = super+p=text:\x02g
keybind = super+b=text:\x02w

# Workspace Navigation (Cmd+Shift+Up/Down & Cmd+Shift+1..9)
keybind = super+shift+arrow_down=text:\x02J
keybind = super+shift+arrow_up=text:\x02K
keybind = super+shift+1=text:\x02!
keybind = super+shift+digit_1=text:\x02!
keybind = super+shift+2=text:\x02@
keybind = super+shift+digit_2=text:\x02@
keybind = super+shift+3=text:\x02#
keybind = super+shift+digit_3=text:\x02#
keybind = super+shift+4=text:\x02$
keybind = super+shift+digit_4=text:\x02$
keybind = super+shift+5=text:\x02%
keybind = super+shift+digit_5=text:\x02%
keybind = super+shift+6=text:\x02^
keybind = super+shift+digit_6=text:\x02^
keybind = super+shift+7=text:\x02&
keybind = super+shift+digit_7=text:\x02&
keybind = super+shift+8=text:\x02*
keybind = super+shift+digit_8=text:\x02*
keybind = super+shift+9=text:\x02(
keybind = super+shift+digit_9=text:\x02(

# Window Splits & Pane Focus Navigation
keybind = super+\=text:\x02%
keybind = super+shift+d=text:\x02%
keybind = super+shift+e=text:\x02"
keybind = super+arrow_left=text:\x02h
keybind = super+arrow_right=text:\x02l
keybind = super+arrow_up=text:\x02k
keybind = super+arrow_down=text:\x02j

# Pane Zoom, Close & Search
keybind = super+shift+f=text:\x02z
keybind = super+shift+x=text:\x02x
keybind = super+f=text:\x02[
