    "enabled": true,
    "platforms": [
      "macos",
      "linux",
      "windows"
    ],
    "build": [
      {
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      },
      {
        "platforms": [
          "windows"
        ],
        "command": [
          "powershell.exe",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "herdr/install.ps1"
        ]
      }
    ],
    "actions": [
      {
        "id": "open-link",
        "title": "nvim sidebar: open clicked file",
        "command": [
          "bin/herdr-nvim",
          "open-link"
        ]
      },
      {
        "id": "pick-file",
        "title": "nvim sidebar: open file from agent output",
        "contexts": [
          "pane"
        ],
        "command": [
          "bin/herdr-nvim",
          "pick-file"
        ]
      },
      {
        "id": "toggle",
        "title": "nvim sidebar: toggle",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "bin/herdr-nvim",
          "toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "open file",
        "placement": "popup",
        "command": [
          "bin/herdr-nvim",
          "picker"
        ]
      },
      {
        "id": "sidebar",
        "title": "nvim sidebar",
        "placement": "split",
        "command": [
          "bin/herdr-nvim",
          "sidebar"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "file-path",
        "title": "Open in nvim sidebar",
        "pattern": "^~?[\\w.@/()\\[\\]\\\\:+-]+[\\\\/][\\w.@()\\[\\]\\\\:+-]+\\.[A-Za-z]\\w*(?::\\d+){0,2}$",
        "action": "open-link"
      },
      {
        "id": "file-url",
        "title": "Open in nvim sidebar",
        "pattern": "^file://",
        "action": "open-link"
      }
    ],
